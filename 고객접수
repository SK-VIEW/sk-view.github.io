<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>평택역 SK VIEW 포털</title>
<meta name="description" content="평택역 SK VIEW 단지소개, 주택형, 단지배치도, 동호수표, 관심고객 신청">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap">
<style>
:root{
  color-scheme:light;
  /* SK 색상 규정: 주요 SK Red·Orange / 보조 Yellow·Green·Teal·Blue·Navy·Purple */
  --red:#EA002C; --red-dark:#C4001F; --red-soft:#FFF0F2; --red-line:#FFC9D3;
  --orange:#F47725; --orange-soft:#FFF4EC; --yellow:#FBBC05; --green:#B3CF0A; --teal:#009A93; --skblue:#0072C6; --navy:#0E306D; --purple:#68127A;
  --ink:#111111; --gray:#707782; --gray-2:#4A4F57; --line:#E6E6E6; --line-2:#D4D4D4; --soft:#F8F8F8; --white:#FFFFFF;
  --tile-teal:#DFF3F2; --tile-yellow:#FFF4D2; --tile-purple:#F3E6F5;
  --t84:#EA002C; --t72:#F47725; --t59a:#009A93; --t59b:#0072C6;
  --c84:#FDE1E7; --c72:#FDE9DC; --c59a:#D9F0EE; --c59b:#DCEBF7;
  --danger:#EA002C; --memo:#B98500; --memo-bg:#FFF8E1;
  --font:"Pretendard Variable","Pretendard","Noto Sans KR",-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-padding-top:188px}
body{margin:0;background:var(--white);color:var(--ink);font-family:var(--font);font-size:15px;line-height:1.6;word-break:keep-all;overflow-wrap:anywhere;-webkit-font-smoothing:antialiased}
h1,h2,h3,p{margin:0}
h1,h2,h3{text-wrap:balance}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.num{font-variant-numeric:tabular-nums}
.wrap{max-width:1200px;margin-inline:auto;padding-inline:24px}

/* ── header ── */
.header{position:sticky;top:0;z-index:30;background:var(--white);border-bottom:1px solid var(--line)}
.header-top{height:108px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo{gap:14px}
.logo-img{display:block;height:56px;width:auto}
.logo-text{display:flex;flex-direction:column;align-items:flex-start;gap:3px;white-space:nowrap}
.logo-name{font-size:34px;font-weight:800;line-height:1.05;letter-spacing:-.025em;color:var(--red)}
.logo-sub{font-size:16px;font-weight:700;line-height:1.2;letter-spacing:.14em;color:#000000}
.util{display:flex;align-items:center;gap:22px;font-size:15px}
.util a{text-decoration:none;color:var(--ink)}
.util a:hover{color:var(--red)}
.gnb{height:64px;display:flex;align-items:center;gap:56px}
.gnb a{font-size:18px;font-weight:700;text-decoration:none;color:var(--ink);white-space:nowrap}
.gnb a:hover,.gnb a[aria-current="true"]{color:var(--red)}

/* ── buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;height:48px;padding-inline:22px;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none;border:0;cursor:pointer;white-space:nowrap}
.btn-blue{background:var(--red);color:#fff}
.btn-blue:hover{background:var(--red-dark)}
.btn-soft{background:var(--red-soft);color:var(--red)}
.btn-soft:hover{background:#FFE0E6}
.btn-line{background:#fff;color:var(--ink);border:1px solid var(--line-2)}
.btn-line:hover{border-color:var(--gray)}
.btn-block{width:100%}

/* ── home ── */
.home{padding-block:48px 0}
.row-hero{display:grid;grid-template-columns:minmax(0,870fr) minmax(0,306fr);gap:24px}
.banner{position:relative;height:360px;border-radius:20px;overflow:hidden;background:var(--red)}
.banner-photo{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:62% 55%}

.banner-text{position:absolute;left:44px;bottom:40px;right:44px;z-index:1;color:#fff;display:flex;flex-direction:column;gap:8px}
.banner-text .eyebrow{font-size:15px;font-weight:600;text-shadow:0 1px 8px rgba(0,0,0,.6)}
.banner-text h1{font-size:40px;font-weight:800;line-height:1.2;letter-spacing:-.02em;text-shadow:0 2px 14px rgba(0,0,0,.55)}
.banner-text p{font-size:20px;font-weight:500;line-height:1.5}
.side-card{border:1px solid var(--line);border-radius:15px;padding:24px;display:flex;flex-direction:column}
.side-card .msg{font-size:18px;font-weight:500;line-height:1.55;flex:1;padding-top:4px}
.side-card .msg b{color:var(--red);font-weight:700}
.side-card .actions{display:flex;flex-direction:column;gap:8px}
.side-card .links{display:flex;justify-content:center;gap:0;margin-top:12px}
.side-card .links a{font-size:14px;font-weight:500;color:var(--gray);text-decoration:none;padding:8px 12px}
.side-card .links a + a{border-left:1px solid var(--line)}
.side-card .links a:hover{color:var(--ink)}

.row-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:40px;align-items:start}
.col{display:flex;flex-direction:column;gap:24px}
.card{border:1px solid var(--line);border-radius:20px;padding:40px;display:flex;flex-direction:column;gap:24px}
.card-label{font-size:20px;font-weight:700;color:var(--gray);display:flex;justify-content:space-between;align-items:center;gap:12px}
.card-label a{font-size:14px;font-weight:500;color:var(--gray);text-decoration:none}
.card-label a:hover{color:var(--red)}
.card-head{font-size:26px;font-weight:700;line-height:1.4;letter-spacing:-.01em}
.kv{margin:0;display:flex;flex-direction:column}
.kv > div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}
.kv > div:first-child{padding-top:0}
.kv > div:last-child{border-bottom:0;padding-bottom:0}
.kv dt{font-size:20px;font-weight:700;color:var(--ink)}
.kv dd{margin:0;font-size:20px;font-weight:500;color:var(--gray);text-align:right;display:flex;align-items:center;gap:8px}
.kv.sm dt{font-size:16px;font-weight:500;color:var(--gray)}
.kv.sm dd{font-size:16px;font-weight:600;color:var(--ink)}
.ex{font-size:11px;font-weight:600;color:var(--gray);background:var(--soft);border:1px solid var(--line);border-radius:4px;padding:1px 5px;line-height:1.5;white-space:nowrap}

.mix{display:flex;flex-direction:column;gap:12px}
.mix-bar{display:flex;height:40px;border-radius:8px;overflow:hidden;gap:2px}
.mix-bar div{display:flex;align-items:center;padding-inline:12px;font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden}
.mix-legend{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 16px;font-size:14px}
.mix-legend li{display:flex;align-items:center;gap:8px}
.mix-legend span{color:var(--gray);margin-left:auto}
.dot{width:10px;height:10px;border-radius:3px;flex-shrink:0;display:inline-block}

.sec-title{font-size:26px;font-weight:700;line-height:1.4;letter-spacing:-.01em;margin-top:80px}
.tiles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:24px}
.tile{text-decoration:none;display:flex;flex-direction:column}
.tile-art{aspect-ratio:1/1;max-width:100%;border-radius:20px;display:flex;align-items:center;justify-content:center;transition:transform .2s}
.tile-art svg{width:62%;height:auto}
.tile:hover .tile-art{transform:translateY(-4px)}
.tile-label{font-size:20px;font-weight:700;color:var(--gray);margin-top:24px}
.tile-head{font-size:26px;font-weight:500;line-height:1.4;color:var(--ink);margin-top:8px}

.band{background:var(--orange-soft);margin-top:80px;padding-block:88px}
.band-in{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:40px;align-items:center}
.band h2{font-size:40px;font-weight:700;line-height:1.4;letter-spacing:-.02em}
.band p{font-size:17px;color:var(--gray-2);margin-top:16px}
.life{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.life div{background:#fff;border-radius:28px;padding:28px 24px;display:flex;flex-direction:column;gap:10px;min-height:170px}
.life svg{width:44px;height:44px}
.life strong{font-size:19px;font-weight:700}
.life span{font-size:14px;color:var(--gray);line-height:1.5}

/* ── sub pages ── */
.sub{display:grid;grid-template-columns:256px minmax(0,1fr);gap:24px;padding-block:48px 120px}
.lnb{align-self:start;position:sticky;top:196px}
.lnb-title{font-size:26px;font-weight:700;line-height:1.4}
.lnb-desc{font-size:16px;font-weight:500;color:var(--gray);margin-top:20px;line-height:1.5}
.lnb ul{list-style:none;margin:24px 0 0;padding:0}
.lnb li a{display:block;padding:16px 0;font-size:18px;font-weight:500;color:var(--gray);text-decoration:none;line-height:1.45}
.lnb li a:hover{color:var(--ink)}
.lnb li a[aria-current="page"]{color:var(--red)}
.content{padding-inline:40px;min-width:0}
.sub.wide{grid-template-columns:minmax(0,1fr)}
.sub.wide .lnb{display:none}
.sub.wide .content{padding-inline:0}
.page-title{font-size:30px;font-weight:700;line-height:1.35;letter-spacing:-.015em}
.page-desc{font-size:16px;color:var(--gray);margin-top:10px;max-width:62ch}
.page-head{padding-bottom:28px;margin-bottom:36px;border-bottom:1px solid var(--ink)}
.block{margin-top:56px;display:flex;flex-direction:column;gap:18px}
.block:first-child{margin-top:0}
.block > h2{font-size:22px;font-weight:700;display:flex;align-items:center;gap:8px}
.block > h2::before{content:"";width:6px;height:6px;background:var(--ink);display:inline-block}
.note{font-size:13px;color:var(--gray)}

.memo{display:none;gap:10px;align-items:flex-start;font-size:13px;line-height:1.6;background:var(--memo-bg);border:1px dashed var(--memo);border-radius:8px;padding:10px 14px;color:var(--ink)}
.memo b{color:var(--memo);font-weight:700;white-space:nowrap}
.draft .memo{display:flex}

.facts{margin:0;display:grid;grid-template-columns:150px minmax(0,1fr);border-top:1px solid var(--ink)}
.facts dt,.facts dd{margin:0;padding:16px 0;border-bottom:1px solid var(--line)}
.facts dt{font-size:16px;color:var(--gray);padding-left:4px}
.facts dd{font-size:16px;font-weight:500}
.facts dd small{display:block;font-size:14px;font-weight:400;color:var(--gray);margin-top:2px}

.biz{position:relative;min-height:780px}
.biz-photo{position:absolute;top:64px;right:0;bottom:0;width:60%;background:#000000}
.biz-photo img{display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:55% 50%}
.biz-card{position:relative;z-index:1;width:min(620px,54%);background:#FFFFFF;padding:44px 40px 34px;box-shadow:0 12px 32px rgba(0,0,0,.12)}
.biz-title{font-size:36px;font-weight:300;letter-spacing:-.02em;color:#000000;margin-bottom:26px}
.biz-title b{font-weight:800;color:var(--navy)}
.biz-dl{margin:0;display:grid;grid-template-columns:128px minmax(0,1fr);row-gap:16px}
.biz-dl dt{font-size:18px;font-weight:700;color:#000000;text-align:center;padding-right:16px;border-right:1px solid rgba(0,0,0,.18);line-height:1.5}
.biz-dl dd{margin:0;padding-left:26px;font-size:17px;color:#000000;line-height:1.5}
.biz-table-wrap{overflow-x:auto;margin-top:32px}
.biz-table{width:100%;border-collapse:collapse;border-top:2px solid var(--navy);border-bottom:1px solid var(--navy);font-size:17px}
.biz-table th{background:var(--navy);color:#FFFFFF;font-weight:700;padding:13px 8px;white-space:nowrap;width:128px;border-bottom:1px solid rgba(255,255,255,.35)}
.biz-table td{text-align:center;color:#000000;padding:13px 6px;border-left:1px solid rgba(0,0,0,.12);border-bottom:1px solid rgba(0,0,0,.12)}
.biz-src{font-size:13px;color:rgba(0,0,0,.55);margin-top:10px}
.terms{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.term{background:var(--soft);border-radius:15px;padding:24px;display:flex;flex-direction:column;gap:6px}
.term strong{font-size:24px;font-weight:700;color:var(--red)}
.term span{font-size:16px;font-weight:600}
.term p{font-size:14px;color:var(--gray)}

.place{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.place > div{border:1px solid var(--line);border-radius:15px;padding:24px;display:flex;flex-direction:column;gap:8px}
.place h3{font-size:18px;font-weight:700}
.place p{font-size:14px;color:var(--gray-2)}
.chipset{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.chipset li{background:var(--red-soft);color:var(--red);font-weight:600;font-size:14px;border-radius:8px;padding:8px 14px}

.seg{display:flex;flex-wrap:wrap;gap:8px}
.seg button{height:44px;padding-inline:18px;border-radius:8px;border:1px solid var(--line-2);background:#fff;color:var(--gray-2);font-size:15px;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
.seg button:hover{border-color:var(--gray)}
.seg button[aria-selected="true"],.seg button[aria-pressed="true"]{background:var(--red);border-color:var(--red);color:#fff}
.seg button[aria-selected="true"] .dot{outline:2px solid #fff}
.type-panel{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;margin-top:24px}
.type-panel .plan-card{order:-1}
.type-info{border:1px solid var(--line);border-radius:20px;padding:32px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 40px;align-items:start}
.type-info .areas{grid-column:2;grid-row:1/span 4}
.type-info .btn{justify-self:start}
.type-area{font-size:52px;font-weight:700;line-height:1;letter-spacing:-.03em}
.type-area sub{font-size:22px;vertical-align:baseline;margin-left:2px;letter-spacing:0}
.type-area small{font-size:18px;font-weight:600;color:var(--gray);margin-left:6px;letter-spacing:0}
.type-count{display:flex;flex-direction:column;gap:2px;padding:14px 16px;background:var(--red-soft);border-radius:12px}
.type-count strong{font-size:18px;font-weight:700;color:var(--red)}
.type-count span{font-size:14px;color:var(--gray-2)}
.areas{margin:0;display:grid;grid-template-columns:auto minmax(0,1fr);font-size:15px;font-variant-numeric:tabular-nums}
.areas dt,.areas dd{margin:0;padding:9px 0;border-bottom:1px solid var(--line)}
.areas dt{color:var(--gray)}
.areas dd{text-align:right;font-weight:600}
.areas dd small{font-weight:400;color:var(--gray);margin-left:4px}
.areas .hl{color:var(--ink);font-weight:700}
.type-rent{font-size:14px;font-weight:600;color:var(--red);text-decoration:none}
.type-rent:hover{text-decoration:underline}
.type-dongs{font-size:14px;color:var(--gray-2);line-height:1.6}
.type-dongs b{display:block;color:var(--gray);font-weight:500;font-size:13px;margin-bottom:2px}
.plan-card{border:1px solid var(--line);border-radius:20px;padding:20px;display:flex;flex-direction:column;gap:12px;background:#fff}
.plan-card button{all:unset;cursor:zoom-in;display:block;border-radius:10px}
.plan-card button:focus-visible{outline:2px solid var(--red);outline-offset:4px}
.plan-card img{display:block;width:100%;height:auto;max-width:100%}
.plan-card figcaption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--gray)}
.lightbox{position:fixed;inset:0;z-index:100;background:rgba(17,24,39,.82);display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto}
.lightbox img{max-width:min(1100px,100%);width:100%;height:auto;background:#fff;border-radius:12px;padding:12px}
.lightbox .close{position:fixed;top:16px;right:16px;width:44px;height:44px;border-radius:50%;border:0;background:#fff;color:var(--ink);font-size:22px;cursor:pointer}

.plan-wrap{border:1px solid var(--line);border-radius:20px;padding:20px;overflow-x:auto}
.plan-wrap svg{display:block;width:100%;min-width:700px;height:auto}
.p-ground{fill:#FFF8F4;stroke:var(--red);stroke-width:4;stroke-dasharray:18 12}
.p-road path{fill:none;stroke:#FFFFFF;stroke-width:34;stroke-linecap:round}
.p-green > *{fill:#EEF5C8;stroke:#C9DC5A;stroke-width:3}
.p-glabel text{fill:#5B6B00;font-family:var(--font);font-size:24px;font-weight:700;text-anchor:middle}
.p-entr path{fill:var(--orange)}
.p-entr text{fill:#D65A0E;font-family:var(--font);font-size:26px;font-weight:700;text-anchor:middle}
.mk rect{fill:var(--red)}
.mk path{fill:var(--red)}
.mk circle{fill:var(--red);stroke:#fff;stroke-width:5}
.mk text{fill:#fff;font-family:var(--font);font-size:24px;font-weight:700;text-anchor:middle}
.bldg{cursor:pointer}
.bldg rect{fill:var(--navy);transition:fill .15s}
.bldg text{fill:#fff;font-family:var(--font);font-size:28px;font-weight:700;pointer-events:none;text-anchor:middle;dominant-baseline:central}
.swipe-hint{display:none;font-size:13px;color:var(--gray);text-align:center;margin:0 0 8px}
.plan-box{border:1px solid var(--line);border-radius:20px;padding:16px;background:#fff}
.plan-stage{position:relative;max-width:100%}
.plan-stage img{display:block;width:100%;height:auto;border-radius:10px}
.plan-mk{position:absolute;transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;pointer-events:none;z-index:2}
.plan-mk span{background:var(--red);color:#fff;font-size:14px;font-weight:700;padding:6px 12px;border-radius:999px;white-space:nowrap;box-shadow:0 4px 12px rgba(234,0,44,.3)}
.plan-mk::after{content:"";width:0;height:0;border-left:7px solid transparent;border-right:7px solid transparent;border-top:9px solid var(--red);margin-top:-1px}
.plan-hot{position:absolute;transform:translate(-50%,-50%);width:15%;height:9%;border:0;background:transparent;border-radius:8px;cursor:pointer;z-index:1}
.plan-hot:hover,.plan-hot:focus-visible{background:rgba(234,0,44,.12);outline:2px solid var(--red);outline-offset:0}
.plan-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}
.fac-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.fac-list > div{border:1px solid var(--line);border-radius:15px;padding:20px 22px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 12px;align-items:center}
.fac-list strong{font-size:17px;font-weight:700}
.fac-list .where{font-size:13px;font-weight:700;color:var(--red);background:var(--red-soft);border-radius:6px;padding:3px 8px}
.fac-list p{grid-column:1/-1;font-size:14px;color:var(--gray)}
.bldg:hover rect,.bldg:focus-visible rect{fill:var(--red)}
.bldg:focus-visible{outline:none}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:14px;color:var(--gray-2)}
.legend span{display:inline-flex;align-items:center;gap:6px}

.dong-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 16px}
.dong-head h2{font-size:26px;font-weight:700}
.dong-head span{font-size:15px;color:var(--gray)}
.ho-wrap{overflow:auto;max-height:640px;border:1px solid var(--line);border-radius:15px}
.ho{border-collapse:separate;border-spacing:0;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
.ho th{position:sticky;top:0;background:var(--soft);color:var(--gray-2);font-weight:600;padding:10px 6px;border-bottom:1px solid var(--line);text-align:center;font-size:12.5px;line-height:1.4;z-index:1}
.ho .fl{width:56px;color:var(--gray);text-align:center;font-weight:500;border-right:1px solid var(--line);background:var(--soft)}
.ho td{padding:2px}
.ho .u{display:block;text-align:center;padding:5px 0;border-radius:4px;min-width:64px;font-weight:500}
.u.t84{background:var(--c84)}.u.t72{background:var(--c72)}.u.t59A{background:var(--c59a)}.u.t59B{background:var(--c59b)}
.u.none{background:repeating-linear-gradient(45deg,transparent 0 5px,var(--line) 5px 6px)}

.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
.steps li{border:1px solid var(--line);border-radius:15px;padding:22px 18px;display:flex;flex-direction:column;gap:10px;position:relative}
.steps li:first-child{border-color:var(--red);background:var(--red-soft)}
.step-n{font-size:13px;font-weight:700;color:var(--red)}
.steps h3{font-size:17px;font-weight:700;line-height:1.4}
.steps p{font-size:14px;color:var(--gray-2)}
.docs{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}
.docs li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px 4px;border-bottom:1px solid var(--line);flex-wrap:wrap;font-size:16px}
.docs .meta{font-size:13px;color:var(--gray)}
.doc-name{display:flex;flex-direction:column;gap:2px;font-size:17px}
.doc-name b{color:var(--red);font-weight:700}
.doc-name small{font-size:13px;color:var(--gray)}
.doc-btn{height:40px;padding-inline:16px}

.form{border:1px solid var(--line);border-radius:20px;padding:40px;display:flex;flex-direction:column;gap:28px}
.row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.field{display:flex;flex-direction:column;gap:8px;min-width:0}
.field > label,.field legend{font-size:15px;font-weight:600;padding:0}
.req{color:var(--danger);margin-left:3px}
fieldset{border:0;margin:0;padding:0;min-width:0}
input[type="text"],input[type="tel"],select,textarea{font:inherit;font-size:15px;color:var(--ink);background:#fff;border:1px solid var(--line-2);border-radius:8px;height:48px;padding:0 14px;width:100%}
textarea{height:auto;min-height:110px;padding:12px 14px;resize:vertical}
input::placeholder,textarea::placeholder{color:#A0A6B1}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--red);box-shadow:0 0 0 3px rgba(234,0,44,.14)}
.chips{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:8px}
.chip{position:relative;border:1px solid var(--line-2);border-radius:8px;padding:12px 14px;cursor:pointer;display:flex;flex-direction:column;background:#fff}
.chip input{position:absolute;opacity:0;pointer-events:none}
.chip strong{font-size:16px;font-weight:700}
.chip small{font-size:13px;color:var(--gray)}
.chip:has(input:checked){border-color:var(--red);background:var(--red-soft);box-shadow:inset 0 0 0 1px var(--red)}
.chip:has(input:checked) strong{color:var(--red)}
.chip:has(input:focus-visible){outline:2px solid var(--red);outline-offset:2px}
.err{font-size:13px;color:var(--danger)}
.err:empty{display:none}
.agree{display:flex;flex-direction:column;gap:10px;padding:20px;background:var(--soft);border-radius:12px}
.agree-check{display:flex;gap:10px;align-items:center;font-size:15px;font-weight:600;cursor:pointer}
.agree-check input{width:20px;height:20px;accent-color:var(--red);margin:0;flex-shrink:0}
details.consent{font-size:13px;color:var(--gray-2)}
details.consent summary{cursor:pointer;width:fit-content;color:var(--gray)}
details.consent table{width:100%;border-collapse:collapse;margin-top:10px;background:#fff}
details.consent th,details.consent td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}
details.consent th{width:96px;font-weight:600;background:var(--soft)}
.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.form{position:relative}
.btn[disabled]{opacity:.6;cursor:progress}
.form-foot{display:flex;justify-content:flex-end}
.form-foot .btn{min-width:200px}
.done{border:1px solid var(--red);border-radius:20px;padding:40px;display:flex;flex-direction:column;gap:18px}
.done .ok{width:48px;height:48px;border-radius:50%;background:var(--red-soft);display:flex;align-items:center;justify-content:center}
.done h2{font-size:24px;font-weight:700}
.done p{color:var(--gray-2)}

.rent-top{display:flex;justify-content:space-between;align-items:center;gap:10px 16px;flex-wrap:wrap;margin-bottom:14px}
.period{display:inline-flex;align-items:center;gap:8px;background:var(--red-soft);color:var(--ink);border:1px solid var(--red-line);border-radius:999px;padding:7px 16px;font-size:14px}
.period b{color:var(--red);font-weight:700}
.rtable-wrap{overflow-x:auto;border-top:2px solid var(--navy)}
.rtable{width:100%;border-collapse:collapse;font-size:15px;min-width:660px}
.rtable th{background:var(--navy);color:#FFFFFF;font-weight:700;padding:12px 10px;border:1px solid rgba(255,255,255,.22);white-space:nowrap}
.rtable td{padding:12px 12px;border:1px solid var(--line);text-align:center;color:var(--ink);white-space:nowrap}
.rtable td.money{text-align:right}
.rtable td.rentv{text-align:right;font-weight:700;color:var(--red)}
.rtable td.grp{font-weight:700;background:#FFFFFF}
.rtable tr.gen td{background:var(--red-soft)}
.rtable tr.gen td.grp{background:#FFF7F8}
.rtable td.sel{color:var(--gray-2)}
.rtable tr.std td.sel{color:var(--ink);font-weight:600}
.notes{margin:16px 0 0;padding-left:18px;font-size:14px;color:var(--gray-2);display:flex;flex-direction:column;gap:4px}
.notes a{color:var(--red);font-weight:600}
.contact-list{border:1px solid var(--line);border-radius:20px;padding:12px 40px}
.contact-list > div{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}
.contact-list > div:last-child{border-bottom:0}
.contact-list strong{font-size:20px;font-weight:700}
.contact-list small{grid-column:1;font-size:14px;color:var(--gray)}
.contact-list .tel{grid-column:2;grid-row:1/span 2;font-size:20px;font-weight:500;color:var(--gray);display:flex;align-items:center;gap:8px;white-space:nowrap}
.addr{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;background:var(--soft);border-radius:15px;padding:24px 28px}
.addr strong{display:block;font-size:18px}
.addr span{font-size:14px;color:var(--gray)}

/* ── footer ── */
.footer{background:var(--soft)}
.footer .wrap{padding-block:20px 40px}
.f-links{display:flex;gap:40px;padding-bottom:18px;border-bottom:1px solid var(--line)}
.f-links a{font-size:12px;font-weight:500;color:var(--gray);text-decoration:none}
.f-links a:nth-child(2){font-weight:700}
.f-name{font-size:16px;font-weight:700;color:var(--gray);margin-top:28px}
.f-info{font-size:12px;font-weight:500;color:var(--gray);margin-top:14px;line-height:1.7}

@media (prefers-reduced-motion: reduce){ .tile-art{transition:none} .tile:hover .tile-art{transform:none} }

