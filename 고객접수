  function spans(rows, col){
    var out=[], i=0;
    while(i<rows.length){ var j=i; while(j<rows.length && rows[j][col]===rows[i][col]) j++; out[i]=j-i; for(var k=i+1;k<j;k++) out[k]=0; i=j; }
    return out;
  }
  (function(){
    var s0=spans(RENT,0), s1=spans(RENT,1), s2=spans(RENT,2);
    var h='<thead><tr><th>공급유형</th><th>구분</th><th>타입</th><th>선택타입</th><th>임대보증금(원)</th><th>월 임대료(원)</th></tr></thead><tbody>';
    RENT.forEach(function(r,i){
      h+='<tr class="'+(r[0]==="일반공급"?'gen':'')+(r[3]==="표준형"?' std':'')+'">';
      if(s0[i]) h+='<td class="grp" rowspan="'+s0[i]+'">'+r[0]+'</td>';
      if(s1[i]) h+='<td class="grp" rowspan="'+s1[i]+'">'+r[1]+'</td>';
      if(s2[i]) h+='<td class="grp" rowspan="'+s2[i]+'">'+r[2]+'</td>';
      h+='<td class="sel">'+r[3]+'</td><td class="money">'+fmt(r[4])+'</td><td class="rentv">'+fmt(r[5])+'</td></tr>';
    });
    $("#rent-table").innerHTML=h+'</tbody>';
    var d0=spans(RETAIL,0);
    var g='<thead><tr><th colspan="2" rowspan="2">구분</th><th colspan="4">공급면적(㎡)</th><th colspan="2">임대조건(원)</th></tr>'+
          '<tr><th>전용</th><th>공용</th><th>공급</th><th>평형</th><th>임대차보증금</th><th>임대료</th></tr></thead><tbody>';
    RETAIL.forEach(function(r,i){
      g+='<tr>';
      if(d0[i]) g+='<td class="grp" rowspan="'+d0[i]+'">'+r[0]+'</td>';
      g+='<td>'+r[1]+'</td><td class="money">'+r[2]+'</td><td class="money">'+r[3]+'</td><td class="money">'+r[4]+'</td><td>'+r[5]+'</td><td class="money">'+fmt(r[6])+'</td><td class="rentv">'+fmt(r[7])+'</td></tr>';
    });
    $("#retail-table").innerHTML=g+'</tbody>';
    var dongs={}; RETAIL.forEach(function(r){ dongs[r[0]]=1; });
    $("#retail-count").textContent = "총 "+Object.keys(dongs).length+"개 동 · "+RETAIL.length+"개 호실";
  })();

  /* form */
  var form=$("#apply-form");
  $("#f-phone").addEventListener("input", function(){
    var v=this.value.replace(/\D/g,"").slice(0,11);
    this.value = v.length<4 ? v : v.length<8 ? v.slice(0,3)+"-"+v.slice(3) : v.slice(0,3)+"-"+v.slice(3,v.length-4)+"-"+v.slice(-4);
  });
  function setErr(id,msg){ $("#e-"+id).textContent = msg||""; }
  form.addEventListener("submit", function(e){
    e.preventDefault();
    var name=$("#f-name").value.trim(), phone=$("#f-phone").value.trim(), typeEl=form.querySelector('input[name="type"]:checked');
    var ok=true, first=null;
    function fail(id,msg,el){ setErr(id,msg); ok=false; first=first||el; }
    ["name","phone","type","agree"].forEach(function(k){ setErr(k); });
    if (name.length<2) fail("name","성명을 2자 이상 입력하세요.",$("#f-name"));
    if (!/^01[016789]-\d{3,4}-\d{4}$/.test(phone)) fail("phone","휴대폰 번호를 010-1234-5678 형식으로 입력하세요.",$("#f-phone"));
    if (!typeEl) fail("type","희망 주택형을 하나 선택하세요.",$("#f-type-84"));
    if (!$("#f-agree").checked) fail("agree","관심고객 등록을 위해 개인정보 수집·이용 동의가 필요합니다.",$("#f-agree"));
    if (!ok){ first.focus(); return; }
    var memo=$("#f-memo").value.trim();
    var payload = {
      name:name, phone:phone, type:"전용 "+TYPES[typeEl.value].label, when:$("#f-when").value,
      size:$("#f-size").value, memo:memo, agree:"Y", website:$("#f-website").value, page:location.href
    };
    function showDone(){
      var rows=[["성명",name],["휴대폰",phone.replace(/-(\d{3,4})-/,"-****-")],["희망 주택형",payload.type],["입주 시기",payload.when],["입주 인원",payload.size]];
      if(memo) rows.push(["문의 사항",memo]);
      var dl=$("#done-list"); dl.innerHTML="";
      rows.forEach(function(r){ var dt=document.createElement("dt"); dt.textContent=r[0]; var dd=document.createElement("dd"); dd.textContent=r[1]; dl.appendChild(dt); dl.appendChild(dd); });
      form.hidden=true; $("#apply-done").hidden=false; $("#done-title").focus();
    }
    if (!FORM_ENDPOINT){ showDone(); return; }   // 접수처 미연결 시(시안) 화면만 전환
    var btn=$("#f-submit"); btn.disabled=true; btn.textContent="제출하는 중…"; setErr("submit");
    fetch(FORM_ENDPOINT, { method:"POST", mode:"no-cors", body:new URLSearchParams(payload) })
      .then(function(){ showDone(); })
      .catch(function(){ setErr("submit","전송하지 못했어요. 인터넷 연결을 확인한 뒤 다시 제출하거나 임대관리센터(031-656-7310)로 연락해 주세요."); })
      .then(function(){ btn.disabled=false; btn.textContent="신청서 제출"; });
  });
  $("#apply-again").addEventListener("click", function(){ form.reset(); $("#apply-done").hidden=true; form.hidden=false; $("#f-name").focus(); });

  $("#biz-img").src = document.querySelector(".banner-photo").src;
  renderType(); renderUnits();
  show(location.hash.slice(1), true);
})();
